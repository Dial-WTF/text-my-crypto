  "dependencies": {
    "@neondatabase/serverless": "~1.2.0",
    "@opennextjs/cloudflare": "1.20.9",
    "@solana-program/memo": "~0.15.0",
    "@solana-program/token": "~0.17.0",
    "@solana/kit": "~8.4.0",
    "ai": "^7.0.134",
    "drizzle-orm": "~0.45.4",
    "next": "16.4.0",
    "qrcode": "~1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "~0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
