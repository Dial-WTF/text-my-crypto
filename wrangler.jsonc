{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-my-crypto",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "text-my-crypto" }],
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://text-my-crypto.raspy-thunder-20d2.workers.dev",
    "DIAL_OPERATOR_NUMBER": "+18066071387",
    "PAYPHONE_BASE_URL": "https://payphone.wtf",
    "SMS_MODE": "payphone",
    "SOLANA_RPC_URL": "https://api.devnet.solana.com",
    "ESCROW_TTL_DAYS": "7",
    "SIGNUP_DRIP_USD": "2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "text-my-crypto",
      "database_id": "f66d243f-6966-45d5-9f57-f0b88ef98e44",
      "migrations_dir": "drizzle"
    }
  ]
}
