{
  "name": "text-my-crypto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && node scripts/scrub-build-env.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/scrub-build-env.mjs && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "smoke": "node scripts/smoke.mjs",
    "ship": "node scripts/ship.mjs",
    "secrets:push": "node scripts/secrets-push.mjs",
    "contracts:build": "node scripts/build-contracts.mjs",
    "program:build": "node scripts/build-program.mjs",
    "contracts:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy-test-usd.mjs",
    "escrow:deploy:arbitrum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy-arbitrum-escrow.mjs",
    "chains:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chains-status.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply text-my-crypto --local",
    "db:migrate:remote": "wrangler d1 migrations apply text-my-crypto --remote",
    "db:migrate:staging": "wrangler d1 migrations apply text-my-crypto-staging --env staging --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "~2.3.1",
    "@opennextjs/cloudflare": "1.20.9",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@solana-program/memo": "~0.15.0",
    "@solana-program/token": "~0.17.0",
    "@solana/kit": "~8.4.0",
    "ai": "^7.0.134",
    "drizzle-orm": "~0.45.4",
    "next": "16.4.0",
    "qrcode": "~1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.4",
    "workers-ai-provider": "4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@modelcontextprotocol/client": "~2.3.1",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "~0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "knip": "^6.40.0",
    "litesvm": "1.5.0",
    "sql.js": "~1.14.2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@10.33.4",
  "license": "AGPL-3.0-only"
}
