{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-my-crypto",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "text-my-crypto" }],
  "observability": { "enabled": true },
  // Workers AI: the operator's plain-English understanding. A binding, so no API key.
  "ai": { "binding": "AI" },
  "vars": {
    "APP_URL": "https://text-my-crypto.raspy-thunder-20d2.workers.dev",
    "DIAL_OPERATOR_NUMBER": "+18066071387",
    "PAYPHONE_BASE_URL": "https://payphone.wtf",
    "SMS_MODE": "payphone",
    "ESCROW_TTL_DAYS": "7",
    // Escrow for people not on Dial yet: "on" uses the dial_escrow program (solana/README.md).
    "ESCROW_PROGRAM": "on",
    "SIGNUP_DRIP_USD": "2",
    // "yes" adds "by Dial.Work" after the site's name in titles, share previews, the wordmark and cards.
    "SHOW_BYLINE": "no",
    // Chains that settle in production. Add one only after `pnpm chains:status` shows its treasury ready.
    "CHAINS": "solana,tempo,ethereum,robinhood,base,arbitrum,hyperevm",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "text-my-crypto",
      "database_id": "f66d243f-6966-45d5-9f57-f0b88ef98e44",
      "migrations_dir": "drizzle"
    }
  ],
  // Inbound texts are queued by the webhook and handled by the consumer in worker.ts.
  // Create once per account: `wrangler queues create sms-inbound` and `wrangler queues create sms-inbound-dlq`.
  "queues": {
    "producers": [{ "binding": "SMS_INBOUND", "queue": "sms-inbound" }],
    "consumers": [
      {
        "queue": "sms-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_retries": 8,
        "retry_delay": 30,
        "dead_letter_queue": "sms-inbound-dlq"
      }
    ]
  },
  // The watchdog (worker.ts scheduled → /api/sms/<secret>/watchdog): health, unanswered texts and
  // Payphone reconciliation every minute; texts ALERT_PHONE on problems.
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    // Staging: its own Worker, D1 and queues. SMS_MODE=log, so it never sends a real text; the smoke
    // test (pnpm smoke --env staging) reads replies from the log. Same testnet chains as production.
    // Bindings and vars are not inherited, so everything the app reads is repeated here.
    "staging": {
      "name": "text-my-crypto-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "text-my-crypto-staging" }],
      // Every minute, for the escrow reconciler (it settles program escrow fundings that didn't confirm in
      // time; the program is on here). The watchdog runs too, but SMS_MODE=log means nothing is texted:
      // its alerts and the reconciler's texts only land in the SMS log.
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_URL": "https://text-my-crypto-staging.raspy-thunder-20d2.workers.dev",
        "DIAL_OPERATOR_NUMBER": "+18066071387",
        "PAYPHONE_BASE_URL": "https://payphone.wtf",
        "SMS_MODE": "log",
        "ESCROW_TTL_DAYS": "7",
        "ESCROW_PROGRAM": "on",
        // Each smoke run signs up a sender and a newcomer; the sender's $1 drop covers its two $0.50 payments.
        "SIGNUP_DRIP_USD": "1",
        "SHOW_BYLINE": "no",
        // Same chains as production, so smoke runs exercise what production settles on.
        "CHAINS": "solana,tempo,ethereum,robinhood,base,arbitrum,hyperevm",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "text-my-crypto-staging",
          "database_id": "84b429d4-d684-4c66-ba15-2a4b1089b39b",
          "migrations_dir": "drizzle"
        }
      ],
      "queues": {
        "producers": [{ "binding": "SMS_INBOUND", "queue": "sms-inbound-staging" }],
        "consumers": [
          {
            "queue": "sms-inbound-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 0,
            "max_retries": 8,
            "retry_delay": 30,
            "dead_letter_queue": "sms-inbound-staging-dlq"
          }
        ]
      }
    }
  }
}
